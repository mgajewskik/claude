  "model": "opus[1m]",
  "skillOverrides": {
    "plantuml-diagrams": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-writes-outside-cwd.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/mgajewskik/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "bashEditDiffEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "terraform-lsp@personal": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "personal": {
      "source": {
        "source": "directory",
        "path": "/home/mgajewskik/.claude/local-plugins"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "/var/tmp",
        "~/.cache",
        "~/.local/share/mise",
        "~/.local/state/mise",
        "~/.local/share/uv",
        "~/.local/share/rtk",
        "~/go/pkg",
        "~/.ansible",
        "/run/user/1000/terminal-browser-059b082c",
        "~/.local/share/terminal-browser-059b082c",
        "~/.local/state/terminal-browser-059b082c",
        "~/.config/terminal-browser-059b082c",
        "~/.local/state/terminal-browser-interop"
      ]
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
